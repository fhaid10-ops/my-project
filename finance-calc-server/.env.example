PORT=5055

# من Interakt: Settings → Developer Settings → Secret Key
INTERAKT_API_KEY=

# كود قالب واتساب المعتمد في إنترأكت لمتابعة «هل تم تقديم الطلب»
# (Templates → الاسم الإنجليزي/الكود وليس العنوان العربي)
INTERAKT_FOLLOWUP_TEMPLATE=
INTERAKT_FOLLOWUP_TEMPLATE_LANG=ar

# اختياري: حماية Webhook
WEBHOOK_SECRET=change-me

# رمز دخول لوحة التحكم /admin
# إذا فاضي، start-calc.bat يحط تلقائيًا: 123456
ADMIN_TOKEN=123456
